{
  "name": "pouf-monorepo",
  "private": true,
  "workspaces": [
    "registry",
    "gallery",
    "www"
  ],
  "scripts": {
    "typecheck": "bunx tsc --noEmit -p registry && bunx tsc --noEmit -p gallery",
    "test": "bun test",
    "gallery": "bun --cwd gallery dev",
    "gate": "bun gallery/harness/gate.ts",
    "gate:golden": "bun gallery/harness/gate.ts --write-golden",
    "check:deps": "bun scripts/check-block-deps.ts",
    "props": "bun scripts/extract-props.ts",
    "audit:responsive": "cd gallery && node scripts/audit-responsive.mjs",
    "review:ui": "cd gallery && node scripts/review-ui.mjs",
    "verify:expansion": "cd gallery && node scripts/verify-expansion.mjs"
  }
}
