---
import '@fontsource-variable/nunito'
import '@fontsource-variable/fredoka'
/* Imported for their URLs so the two faces actually used above the fold can be
 * preloaded. fontsource ships font-display:swap, so without this the first
 * paint is a system fallback and every heading and label REFLOWS when the real
 * face arrives — a visible layout shift, and the reason the snapshot gate was
 * platform-dependent. The ?url import resolves to the build-hashed path, so it
 * can never drift from what the CSS requests.
 * Latin only: the other subsets are declared with unicode-range and are not
 * fetched unless a page actually contains those characters. */
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url'
import fredokaLatin from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url'
import '../styles/site.css'
import { ToasterMount } from '../components/ToasterMount'
import { CommandPalette } from '../components/CommandPalette'
import { SITE_HOST, SITE_ORIGIN } from '../data/site'


interface Props {
  title?: string
  description?: string
  wide?: boolean
  /** Extra JSON-LD node(s) for this page specifically (e.g. SoftwareSourceCode
   * on the homepage). The sitewide WebSite graph below is emitted regardless. */
  schema?: Record<string, unknown> | Record<string, unknown>[]
}
const { title = 'Pouf', description = 'A puffy, pastel, maximalist UI kit for React. Claymorphism as a shadcn-style registry — copy it in, own the source.', wide = false, schema } = Astro.props
const wrapClass = wide ? 'site-wide' : 'site-wrap'
const pageTitle = title === 'Pouf' ? 'Pouf — puffy, maximalist UI for React' : `${title} · Pouf`
// Astro.url already carries the trailing slash a directory-format static build
// serves (e.g. /components/), so this is the one true canonical for the page —
// no hand-rolled trailing-slash logic to drift from how the site is actually built.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_ORIGIN)
const ogImageURL = new URL('/og-image.png', Astro.site ?? SITE_ORIGIN)
// WebSite is true of every page; it's the site-wide identity, not a per-page claim.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Pouf',
  url: SITE_ORIGIN,
  description: 'A puffy, pastel, maximalist UI kit for React, distributed as a shadcn-style registry.',
}
const schemaNodes = [websiteSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Before the stylesheet, so the fetch starts with the CSS rather than
        after the CSS has been parsed and the first layout has already been
        drawn in a fallback face. crossorigin is required even same-origin:
        fonts are fetched in CORS mode, and a preload without it is discarded
        and re-fetched, which is worse than no preload at all. */}
    <link rel="preload" as="font" type="font/woff2" href={nunitoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fredokaLatin} crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pouf" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pouf — puffy, pastel, maximalist UI kit for React" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schemaNodes.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
    {/* Runs before first paint, so the page never flashes light then repaint
        dark. Inline and synchronous on purpose — a deferred script or a React
        effect would both land after the browser has already painted. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('pouf-theme')
          var theme =
            saved === 'light' || saved === 'dark'
              ? saved
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
          document.documentElement.setAttribute('data-theme', theme)
        } catch (e) {
          /* Private mode can throw on localStorage; light is a fine default. */
          document.documentElement.setAttribute('data-theme', 'light')
        }
      })()
    </script>
  </head>
  <body style="background: var(--bg); color: var(--ink); font-family: var(--font); font-weight: 700; min-height: 100vh; margin: 0;">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <!-- Decorative cushion-blob field: colour and depth behind everything. -->
    <div class="blob-field" aria-hidden="true">
      <span style="width:520px; height:520px; background:var(--purple); top:-160px; left:-120px; --dur:24s; --del:0s;"></span>
      <span style="width:420px; height:420px; background:var(--pink); top:8%; right:-140px; --dur:19s; --del:-4s;"></span>
      <span style="width:380px; height:380px; background:var(--mint); top:52%; left:-120px; --dur:27s; --del:-9s;"></span>
      <span style="width:440px; height:440px; background:var(--blue); top:68%; right:-120px; --dur:21s; --del:-2s;"></span>
      <span style="width:320px; height:320px; background:var(--yellow); top:120%; left:30%; --dur:25s; --del:-13s;"></span>
    </div>

    <header class="site-header">
      <div class={wrapClass}>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" style="display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink); margin-right:auto;">
            <span aria-hidden="true" style="width:36px; height:36px; border-radius:13px; background:var(--purple); box-shadow: var(--pouf-blob); display:inline-block;"></span>
            <strong class="display" style="font-size:24px;">Pouf</strong>
          </a>
          {/* The label is wrapped so it can carry text-box-trim. The trim has to
              live on a block container with real line boxes, and .site-link is a
              flex container — its bare text would become an anonymous flex item,
              which the trim never reaches. See .site-link__label in site.css. */}
          <a class="site-link" href="/docs/"><span class="site-link__label">Docs</span></a>
          <a class="site-link" href="/components"><span class="site-link__label">Components</span></a>
          <a class="site-link" href="/blocks"><span class="site-link__label">Blocks</span></a>
          <a class="site-link" href="/examples"><span class="site-link__label">Templates</span></a>
          <a class="site-link" href="/theme"><span class="site-link__label">Theme</span></a>
          <a class="site-link" href="/changelog"><span class="site-link__label">Changelog</span></a>
          <CommandPalette client:load />
          <button
            id="theme-toggle"
            class="site-link theme-toggle"
            type="button"
            aria-label="Switch colour theme"
            aria-pressed="false"
          >
            <span class="theme-toggle__icon" aria-hidden="true"></span>
          </button>
          <a class="site-link" href="https://github.com/moji2002/pouf" target="_blank" rel="noopener noreferrer" style="background:var(--ink); color:var(--bg);"><span class="site-link__label">GitHub</span></a>
          <details class="site-mobile-menu">
            <summary class="site-link site-mobile-menu__trigger">
              <span class="site-link__label">Menu</span>
            </summary>
            <div class="site-mobile-menu__panel">
              <a href="/docs/">Docs</a>
              <a href="/components">Components</a>
              <a href="/blocks">Blocks</a>
              <a href="/examples">Templates</a>
              <a href="/theme">Theme</a>
              <a href="/changelog">Changelog</a>
              <a href="https://github.com/moji2002/pouf" target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main id="main-content" class={wrapClass} style="padding-top:36px; padding-bottom:96px;">
      <slot />
    </main>

    <!-- Global toast stack (fixed, top-right). toast() renders here. -->
    <ToasterMount client:idle />

    <footer style="position:relative; z-index:1; margin-top:40px;">
      <div class={wrapClass} style="padding-bottom:48px;">
        <div class="cushion" style="padding:36px; display:flex; flex-wrap:wrap; gap:20px; align-items:center;">
          <div style="display:flex; align-items:center; gap:12px;">
            <span aria-hidden="true" style="width:44px; height:44px; border-radius:16px; background:var(--pink); box-shadow: var(--pouf-blob); display:inline-block;"></span>
            <div>
              <div class="display" style="font-size:22px;">Pouf</div>
              <div style="color:var(--muted); font-weight:700; font-size:14px;">MIT licensed · Built with Pouf</div>
              <div class="site-byline">
                by <a class="site-foot-link" href="https://github.com/moji2002" target="_blank" rel="noopener noreferrer">Mojtaba Beheshti</a>
                <span aria-hidden="true">·</span>
                {/* Relative, not the absolute SITE_ORIGIN — this footer is
                    served FROM that origin, so an absolute self-link would break
                    on a preview deploy or when running the site locally. The
                    label is derived so it can never drift from where the
                    install commands actually point. */}
                <a class="site-foot-link" href="/">{SITE_HOST}</a>
              </div>
            </div>
          </div>
          <div style="margin-left:auto; display:flex; gap:20px; flex-wrap:wrap; font-weight:800;">
            <a class="site-foot-link" href="/docs/">Docs</a>
            <a class="site-foot-link" href="/components">Components</a>
            <a class="site-foot-link" href="/blocks">Blocks</a>
            <a class="site-foot-link" href="/examples">Templates</a>
            <a class="site-foot-link" href="https://github.com/moji2002/pouf" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
        <p style="text-align:center; color:var(--muted); font-weight:700; font-size:13px; margin-top:20px;">Visual language adapted from <a href="https://github.com/novusgfx/retro-design-system" target="_blank" rel="noopener noreferrer" style="color:var(--muted); font-weight:800;">novusgfx/retro-design-system</a> (MIT).</p>
      </div>
    </footer>

    <script>
      // Scroll-reveal: reveal .reveal sections as they enter the viewport.
      // No-op under reduced motion (the CSS keeps them visible).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (!reduce && 'IntersectionObserver' in window) {
        // Only now hide the reveal sections — without this class they stay visible.
        document.documentElement.classList.add('js')
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in')
                io.unobserve(e.target)
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        )
        for (const el of document.querySelectorAll('.reveal')) io.observe(el)
      }
    </script>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle')
        if (!btn) return
        var root = document.documentElement
        var sync = function () {
          var dark = root.getAttribute('data-theme') === 'dark'
          btn.setAttribute('aria-pressed', String(dark))
          btn.title = dark ? 'Switch to light' : 'Switch to dark'
        }
        sync()
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
          root.setAttribute('data-theme', next)
          try { localStorage.setItem('pouf-theme', next) } catch (e) {}
          sync()
        })
      })()
    </script>
  </body>
</html>

<style is:global>
  /* The toggle reuses .site-link's chrome and only adds the glyph. Sun and moon
     are drawn with a box-shadow + radial-gradient rather than an inline SVG so
     the icon can be swapped purely by the data-theme attribute — no second
     asset, no JS re-render, and it animates between states. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    padding: 8px 12px;
  }
  .theme-toggle__icon {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--ink);
    display: inline-block;
    position: relative;
    transition: background 200ms ease, transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* Light: a full disc with rays. Dark: the disc is masked into a crescent. */
  [data-theme='light'] .theme-toggle__icon {
    box-shadow:
      0 -11px 0 -6.5px var(--ink), 0 11px 0 -6.5px var(--ink),
      -11px 0 0 -6.5px var(--ink), 11px 0 0 -6.5px var(--ink);
    transform: scale(0.72);
  }
  [data-theme='dark'] .theme-toggle__icon {
    box-shadow: inset -5px -3px 0 0 var(--ink);
    background: transparent;
    transform: rotate(-18deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__icon { transition: none; }
  }

  /* ==========================================================================
   * ⌘K COMMAND PALETTE — trigger pill in the nav + the portaled dialog.
   * A self-contained pair (see CommandPalette.tsx): everything here reads the
   * same tokens as the rest of the chrome so it never needs its own dark-mode
   * branch. Reduced motion is handled globally (pouf.css neutralises every
   * animation/transition duration under prefers-reduced-motion), so the pop
   * and fade below need no extra guard. ==================================== */
  .cmdk-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    flex: none;
    border: none;
    cursor: pointer;
    font-family: var(--font);
    font-weight: 800;
    font-size: 14px;
    color: var(--muted);
    background: var(--bg);
    border-radius: 999px;
    padding: 8px 10px 8px 14px;
    box-shadow: var(--pouf-field);
    transition: box-shadow 140ms ease, transform 140ms ease, color 140ms ease;
  }
  .cmdk-trigger:hover {
    color: var(--ink);
    box-shadow: var(--pouf-field-focus);
  }
  .cmdk-trigger:active {
    transform: translateY(1px);
  }
  .cmdk-trigger__label {
    white-space: nowrap;
  }
  .cmdk-kbd {
    font-family: var(--font);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    color: var(--muted);
    background: var(--surface);
    border-radius: 8px;
    padding: 4px 6px;
    box-shadow: var(--pouf-control);
  }
  .cmdk-kbd--sm {
    font-size: 10px;
    padding: 2px 5px;
    margin-right: 3px;
    box-shadow: none;
    background: var(--bg);
  }
  @media (max-width: 780px) {
    .cmdk-trigger__label,
    .cmdk-trigger .cmdk-kbd {
      display: none;
    }
    .cmdk-trigger {
      padding: 8px;
    }
  }

  .cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(58, 46, 92, 0.35);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 20px 20px;
    animation: cmdk-fade 160ms ease;
  }
  .cmdk-dialog {
    width: min(560px, 100%);
    max-height: min(70vh, 560px);
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: var(--r-card);
    box-shadow: var(--pouf-card);
    overflow: hidden;
    animation: cmdk-pop 180ms cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }
  @keyframes cmdk-fade {
    from { opacity: 0; }
  }
  @keyframes cmdk-pop {
    from { opacity: 0; transform: translateY(-12px) scale(0.97); }
  }
  @media (max-width: 640px) {
    .cmdk-overlay { padding: 6vh 12px 12px; }
    .cmdk-dialog { max-height: 80vh; }
  }

  .cmdk-header {
    display: flex;
    align-items: center;
    gap: var(--s3);
    flex: none;
    padding: var(--s4) var(--s5);
    border-bottom: 2px solid rgba(201, 168, 255, 0.2);
    color: var(--muted);
  }
  .cmdk-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }
  .cmdk-input::placeholder {
    color: var(--muted);
    font-weight: 700;
  }
  .cmdk-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }
  .cmdk-close:hover {
    background: var(--bg);
    color: var(--ink);
  }

  .cmdk-list {
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
    padding: var(--s3) var(--s3) var(--s4);
  }
  .cmdk-group + .cmdk-group {
    margin-top: var(--s3);
  }
  .cmdk-group__label {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--muted);
    padding: var(--s2) var(--s3) 6px;
  }
  .cmdk-option {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: var(--s3);
    border-radius: var(--r-control);
    cursor: pointer;
  }
  .cmdk-option--active {
    background: var(--bg);
    box-shadow: var(--pouf-field);
  }
  .cmdk-option__text {
    flex: 1;
    min-width: 0;
  }
  .cmdk-option__title {
    font-weight: 900;
    color: var(--ink);
    font-size: 15px;
  }
  .cmdk-option__blurb {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmdk-option__tag {
    flex: none;
    font-size: 11px;
    font-weight: 800;
    color: var(--muted);
    background: var(--bg);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .cmdk-empty {
    text-align: center;
    color: var(--muted);
    font-weight: 700;
    padding: var(--s7) var(--s4);
    margin: 0;
  }

  .cmdk-footer {
    display: flex;
    gap: var(--s5);
    flex-wrap: wrap;
    flex: none;
    padding: var(--s3) var(--s5);
    border-top: 2px solid rgba(201, 168, 255, 0.2);
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }
</style>
