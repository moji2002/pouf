---
import '@fontsource-variable/nunito'
import '@fontsource-variable/fredoka'
import '../styles/site.css'
import { COMPONENTS, SECTIONS } from '../data/manifest'

interface Props {
  title?: string
  description?: string
  docsSlug?: string | null
  wide?: boolean
}
const { title = 'Pouf', description = 'A puffy, pastel, maximalist UI kit for React. Claymorphism as a shadcn-style registry — copy it in, own the source.', docsSlug = undefined, wide = false } = Astro.props
const showSidebar = docsSlug !== undefined
const bySection = SECTIONS.map((s) => ({ section: s, items: COMPONENTS.filter((c) => c.section === s) })).filter((g) => g.items.length)
const wrapClass = wide ? 'site-wide' : 'site-wrap'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Pouf' ? 'Pouf — puffy, maximalist UI for React' : `${title} · Pouf`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body style="background: var(--bg); color: var(--ink); font-family: var(--font); font-weight: 700; min-height: 100vh; margin: 0;">
    <!-- Decorative cushion-blob field: colour and depth behind everything. -->
    <div class="blob-field" aria-hidden="true">
      <span style="width:520px; height:520px; background:var(--purple); top:-160px; left:-120px;"></span>
      <span style="width:420px; height:420px; background:var(--pink); top:8%; right:-140px;"></span>
      <span style="width:380px; height:380px; background:var(--mint); top:52%; left:-120px;"></span>
      <span style="width:440px; height:440px; background:var(--blue); top:68%; right:-120px;"></span>
      <span style="width:320px; height:320px; background:var(--yellow); top:120%; left:30%;"></span>
    </div>

    <header class="site-header">
      <div class={wrapClass}>
        <nav class="site-nav">
          <a href="/" style="display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink); margin-right:auto;">
            <span aria-hidden="true" style="width:36px; height:36px; border-radius:13px; background:var(--purple); box-shadow: var(--pouf-blob); display:inline-block;"></span>
            <strong class="display" style="font-size:24px;">Pouf</strong>
          </a>
          <a class="site-link" href="/docs/">Docs</a>
          <a class="site-link" href="/docs/button">Components</a>
          <a class="site-link" href="/examples">Examples</a>
          <a class="site-link" href="/changelog">Changelog</a>
          <a class="site-link" href="https://github.com/pouf-ui/pouf" style="background:var(--ink); color:var(--bg);">GitHub</a>
        </nav>
      </div>
    </header>

    <main class={wrapClass} style="padding-top:36px; padding-bottom:96px;">
      {showSidebar ? (
        <div class="docs-grid">
          <aside class="docs-sidebar">
            <a class="site-link" href="/docs/" style="font-weight:900;">Getting started</a>
            {bySection.map((g) => (
              <div style="margin-top:12px;">
                <div style="font-size:11px; font-weight:900; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); padding:4px 12px;">{g.section}</div>
                {g.items.map((c) => (
                  <a class="site-link" href={`/docs/${c.slug}`} aria-current={c.slug === docsSlug ? 'page' : undefined} style="font-size:14px; padding:6px 12px;">{c.title.split(',')[0].split(' (')[0]}</a>
                ))}
              </div>
            ))}
          </aside>
          <div style="min-width:0;">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>

    <footer style="position:relative; z-index:1; margin-top:40px;">
      <div class={wrapClass} style="padding-bottom:48px;">
        <div class="cushion" style="padding:36px; display:flex; flex-wrap:wrap; gap:20px; align-items:center;">
          <div style="display:flex; align-items:center; gap:12px;">
            <span aria-hidden="true" style="width:44px; height:44px; border-radius:16px; background:var(--pink); box-shadow: var(--pouf-blob); display:inline-block;"></span>
            <div>
              <div class="display" style="font-size:22px;">Pouf</div>
              <div style="color:var(--muted); font-weight:700; font-size:14px;">MIT licensed · Built with Pouf</div>
            </div>
          </div>
          <div style="margin-left:auto; display:flex; gap:20px; flex-wrap:wrap; font-weight:800;">
            <a href="/docs/" style="color:var(--ink); text-decoration:none;">Docs</a>
            <a href="/examples" style="color:var(--ink); text-decoration:none;">Examples</a>
            <a href="https://github.com/pouf-ui/pouf" style="color:var(--ink); text-decoration:none;">GitHub</a>
          </div>
        </div>
        <p style="text-align:center; color:var(--muted); font-weight:700; font-size:13px; margin-top:20px;">Visual language adapted from novusgfx/retro-design-system (MIT).</p>
      </div>
    </footer>
  </body>
</html>
