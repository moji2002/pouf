---
import fs from 'node:fs'
import path from 'node:path'
import Site from '../../layouts/Site.astro'
import { Code } from 'astro:components'
import { BlockPreview } from '../../components/BlockPreview'
import { CopyCommand } from '../../components/CopyCommand'
import { BLOCKS, blockInstall } from '../../data/blocks'

export function getStaticPaths() {
  return BLOCKS.map((b) => ({ params: { slug: b.slug }, props: { block: b } }))
}

const { block } = Astro.props
const regPath = path.resolve(process.cwd(), 'public/r', `${block.slug}.json`)
let source = ''
let regDeps: string[] = []
try {
  const reg = JSON.parse(fs.readFileSync(regPath, 'utf8'))
  source = reg.files?.[0]?.content ?? ''
  regDeps = (reg.registryDependencies ?? []).map((u: string) => u.replace('https://pouf.dev/r/', '').replace('.json', '')).filter((n: string) => n !== 'base')
} catch {}

const siblings = BLOCKS.filter((b) => b.category === block.category && b.slug !== block.slug)
---

<Site title={block.title} description={block.blurb} wide>
  <article style="display:flex; flex-direction:column; gap:28px;">
    <div style="display:flex; flex-direction:column; gap:10px;">
      <a href="/blocks" class="back-link">← All blocks</a>
      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <h1 class="display" style="font-size:clamp(40px,5vw,68px); margin:0;">{block.title}</h1>
        {block.category && (
          <span class="sticker" style={`background:var(--${block.tone});`}>{block.category}</span>
        )}
      </div>
      <p style="font-size:19px; font-weight:800; color:var(--muted); margin:0;">{block.blurb}</p>
    </div>

    <div style="display:flex; flex-direction:column; gap:10px; max-width:760px;">
      <span style="font-size:13px; font-weight:900; letter-spacing:1px; text-transform:uppercase; color:var(--muted);">Install this section</span>
      <CopyCommand client:load command={blockInstall(block.slug)} />
      {regDeps.length > 0 && (
        <p style="margin:0; font-size:14px; color:var(--muted); font-weight:800;">Lands with {regDeps.length} components: {regDeps.join(', ')}.</p>
      )}
    </div>

    <!-- A section, not a screen: no browser chrome here, just the page
         background it would sit on. The frame a template gets would overclaim. -->
    <div class="cushion" style="padding:0; overflow:hidden;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; padding:12px 18px; border-bottom:1px solid rgba(201,168,255,0.3);">
        <span style="font-size:12px; font-weight:900; letter-spacing:1px; text-transform:uppercase; color:var(--muted);">Live preview — it works, try it</span>
        <span style="font-size:12px; font-weight:800; color:var(--muted);">section</span>
      </div>
      <div style="background:var(--bg); padding:32px 24px; max-height:82vh; overflow:auto;">
        <BlockPreview client:visible slug={block.slug} />
      </div>
    </div>

    {source && (
      <details>
        <summary style="cursor:pointer; font-weight:900; font-size:17px; padding:8px 0;">View source</summary>
        <div style="margin-top:8px;"><Code code={source} lang="tsx" theme="material-theme-palenight" /></div>
      </details>
    )}

    {siblings.length > 0 && (
      <section style="display:flex; flex-direction:column; gap:14px; padding-top:8px;">
        <h2 class="display" style="font-size:24px; margin:0;">More {block.category?.toLowerCase()} blocks</h2>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          {siblings.map((s) => (
            <a href={`/blocks/${s.slug}`} style={`text-decoration:none; color:var(--ink); font-weight:900; background:var(--${s.tone}); padding:12px 20px; border-radius:16px; box-shadow: var(--pouf-control);`}>{s.title} →</a>
          ))}
        </div>
      </section>
    )}
  </article>
</Site>
