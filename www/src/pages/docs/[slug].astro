---
import fs from 'node:fs'
import path from 'node:path'
import Site from '../../layouts/Site.astro'
import { DemoBox } from '../../components/DemoBox'
import { CopyCommand } from '../../components/CopyCommand'
import { COMPONENTS, installCommand } from '../../data/manifest'
import { allDemos } from '../../../../registry/pouf/demos'

export function getStaticPaths() {
  return COMPONENTS.map((c) => ({ params: { slug: c.slug }, props: { doc: c } }))
}

const { doc } = Astro.props

// The built registry JSON carries the source + declared dependencies.
const regPath = path.resolve(process.cwd(), 'public/r', `${doc.slug}.json`)
let source = ''
let deps: string[] = []
let regDeps: string[] = []
try {
  const reg = JSON.parse(fs.readFileSync(regPath, 'utf8'))
  source = reg.files?.[0]?.content ?? ''
  deps = reg.dependencies ?? []
  regDeps = (reg.registryDependencies ?? []).map((u: string) => u.replace('https://pouf.dev/r/', '').replace('.json', ''))
} catch {}

// Which demo ids exist for each demo key on this page.
const demoIdsByKey = doc.demos.map((key) => ({ key, ids: (allDemos[key] ?? []).map((d) => d.id) }))
---

<Site title={doc.title} description={doc.blurb} docsSlug={doc.slug}>
  <article style="max-width:820px; display:flex; flex-direction:column; gap:24px;">
    <div style="display:flex; flex-direction:column; gap:8px;">
      <h1 style="font-size:40px; font-weight:900; letter-spacing:-1px; margin:0;">{doc.title}</h1>
      <p style="font-size:18px; color:var(--muted); font-weight:700; margin:0;">{doc.blurb}</p>
    </div>

    <div>
      <h2 style="font-size:16px; font-weight:900; letter-spacing:1px; text-transform:uppercase; color:var(--muted); margin:0 0 10px;">Install</h2>
      <CopyCommand client:load command={installCommand(doc.slug)} />
      {(deps.length > 0 || regDeps.length > 0) && (
        <p style="margin:10px 0 0; font-size:13px; color:var(--muted); font-weight:700;">
          Pulls in: {[...regDeps, ...deps].join(', ')}.
        </p>
      )}
    </div>

    {demoIdsByKey.map(({ key, ids }) => (
      <div style="display:flex; flex-direction:column; gap:16px;">
        {doc.demos.length > 1 && <h2 style="font-size:22px; font-weight:900; margin:8px 0 0;">{key}</h2>}
        {ids.map((id) => (
          <div style="display:flex; flex-direction:column; gap:8px;">
            <span style="font-size:11px; font-weight:900; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted);">{id}</span>
            <DemoBox client:visible component={key} id={id} />
          </div>
        ))}
      </div>
    ))}

    {source && (
      <details style="margin-top:8px;">
        <summary style="cursor:pointer; font-weight:900; font-size:16px; padding:8px 0;">View source</summary>
        <pre class="code-block" style="margin-top:8px; max-height:520px;">{source}</pre>
      </details>
    )}
  </article>
</Site>
