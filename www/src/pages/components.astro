---
import fs from 'node:fs'
import path from 'node:path'
import Site from '../layouts/Site.astro'
import { DemoBox } from '../components/DemoBox'
import { CopyCommand } from '../components/CopyCommand'
import { COMPONENTS, SECTIONS, componentInstall } from '../data/manifest'
import { allDemos } from '../../../registry/pouf/demos'

const bySection = SECTIONS.map((s) => ({ section: s, items: COMPONENTS.filter((c) => c.section === s) })).filter((g) => g.items.length)

// Preload each component's source from the built registry JSON.
function sourceFor(slug: string): string {
  try {
    const reg = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'public/r', `${slug}.json`), 'utf8'))
    return reg.files?.map((f: { content: string }) => f.content).join('\n\n') ?? ''
  } catch {
    return ''
  }
}
// Portal-based overlays (dialog, menus, tooltips…) render to document.body, so
// an auto-OPEN demo would cover this whole page. On the combined page we show
// only the closed/trigger demos — click them to open. The auto-open variants
// still live on the isolated gallery (for the snapshot gate). Toaster shows a
// single trigger that fires into the global top-right stack.
const PORTAL_KEYS = new Set([
  'select', 'combobox', 'dialog', 'confirm', 'tooltip', 'dropdown-menu',
  'context-menu', 'menubar', 'hover-card', 'sheet', 'alert-bell', 'bottom-nav',
])
function visibleIds(key: string, ids: string[]): string[] {
  if (key === 'toaster') return ids.filter((id) => id === 'trigger')
  if (PORTAL_KEYS.has(key)) return ids.filter((id) => !/(^|-)open|large/.test(id))
  return ids
}
const enriched = COMPONENTS.map((c) => ({
  ...c,
  source: sourceFor(c.install ?? c.slug),
  demoIds: c.demos.map((key) => ({ key, ids: visibleIds(key, (allDemos[key] ?? []).map((d) => d.id)) })),
}))
---

<Site title="Components" description="Every Pouf component, live on one page." wide>
  <section style="display:flex; flex-direction:column; gap:12px; padding:8px 0 32px;">
    <span class="sticker" style="background:var(--mint); align-self:flex-start; transform:rotate(-2deg);">{COMPONENTS.length} components, one page</span>
    <h1 class="display" style="font-size:clamp(44px,6vw,76px); margin:0;">Components</h1>
    <p style="font-size:19px; font-weight:800; color:var(--muted); margin:0; max-width:60ch;">Every component, live and interactive. Copy the install command, or grab the source.</p>
  </section>

  <div class="comp-layout">
    <!-- Clean vertical TOC — one item per line, no wrapping. -->
    <aside class="comp-toc">
      {bySection.map((g) => (
        <div style="display:flex; flex-direction:column; gap:2px;">
          <span style="font-size:11px; font-weight:900; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); padding:8px 12px 4px;">{g.section}</span>
          {g.items.map((c) => (
            <a class="comp-toc-link" href={`#${c.slug}`}>{c.title.split(',')[0].split(' (')[0]}</a>
          ))}
        </div>
      ))}
    </aside>

    <div style="min-width:0; display:flex; flex-direction:column; gap:56px;">
      {enriched.map((c) => (
        <section id={c.slug} style="scroll-margin-top:88px; display:flex; flex-direction:column; gap:18px;">
          <div style="display:flex; flex-direction:column; gap:6px;">
            <h2 class="display" style="font-size:clamp(28px,3.5vw,40px); margin:0;">{c.title}</h2>
            <p style="font-size:17px; font-weight:800; color:var(--muted); margin:0;">{c.blurb}</p>
          </div>
          <CopyCommand client:load command={componentInstall(c)} />
          {c.demoIds.map(({ key, ids }) => (
            <div style="display:flex; flex-direction:column; gap:12px;">
              {c.demos.length > 1 && <span style="font-size:12px; font-weight:900; letter-spacing:1px; text-transform:uppercase; color:var(--muted);">{key}</span>}
              {ids.map((id) => (
                <div style="display:flex; flex-direction:column; gap:6px;">
                  <span style="font-size:11px; font-weight:800; letter-spacing:1px; text-transform:uppercase; color:var(--muted); opacity:0.7;">{id}</span>
                  <DemoBox client:visible component={key} id={id} />
                </div>
              ))}
            </div>
          ))}
          {c.source && (
            <details>
              <summary style="cursor:pointer; font-weight:900; font-size:15px; padding:6px 0; color:var(--ink);">View source</summary>
              <pre class="code-block" style="margin-top:8px; max-height:480px;">{c.source}</pre>
            </details>
          )}
        </section>
      ))}
    </div>
  </div>

  <style>
    .comp-layout {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 44px;
      align-items: start;
    }
    .comp-toc {
      position: sticky;
      top: 92px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: calc(100vh - 112px);
      overflow-y: auto;
      background: color-mix(in srgb, var(--surface) 70%, transparent);
      border-radius: 24px;
      padding: 14px 8px;
      box-shadow: var(--pouf-card);
    }
    .comp-toc-link {
      display: block;
      font-weight: 800;
      font-size: 14px;
      color: var(--ink);
      text-decoration: none;
      padding: 6px 12px;
      border-radius: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: background 140ms ease;
    }
    .comp-toc-link:hover { background: rgba(201, 168, 255, 0.25); }
    @media (max-width: 900px) {
      .comp-layout { grid-template-columns: minmax(0, 1fr); }
      .comp-toc { display: none; }
    }
  </style>
</Site>
