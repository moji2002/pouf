---
import fs from 'node:fs'
import path from 'node:path'
import Site from '../layouts/Site.astro'
import { Code } from 'astro:components'
import { DemoBox } from '../components/DemoBox'
import { ChartDemoBox } from '../components/ChartDemoBox'
import { CopyCommand } from '../components/CopyCommand'
import { COMPONENTS, SECTIONS, componentInstall } from '../data/manifest'
import { allDemos } from '../../../registry/pouf/demos'
import propTables from '../data/props.json'

interface PropDoc { name: string; type: string; required: boolean; description: string }

const bySection = SECTIONS.map((s) => ({ section: s, items: COMPONENTS.filter((c) => c.section === s) })).filter((g) => g.items.length)

// A pastel per section for the band stickers.
const SECTION_TONE: Record<string, string> = {
  Layout: 'var(--purple)', Typography: 'var(--blue)', Surfaces: 'var(--mint)',
  Forms: 'var(--yellow)', Overlays: 'var(--pink)', Navigation: 'var(--orange)',
  Sections: 'var(--purple)', Feedback: 'var(--pink)', Data: 'var(--blue)',
}
// Right-size each demo's cell. Small controls (a button, a badge) pack tight;
// medium content (a field, a chart, a status row) takes two columns; full-bleed
// chrome (app shells, nav/footer bars, tables) spans the whole card.
const WIDE = new Set([
  'shell', 'sidebar', 'bottom-nav', 'navbar', 'footer', 'cta', 'table',
  'area-chart', 'bar-chart', 'line-chart', 'pie-chart', 'tabs', 'stat', 'metric',
])
const MED = new Set([
  'heading', 'text', 'card', 'row-card', 'stat', 'metric', 'input', 'slider', 'segmented', 'number-input',
  'status', 'mode-banner', 'error-note', 'empty', 'skeleton', 'progress', 'blob',
  'accordion', 'collapsible', 'nav-link', 'breadcrumb',
])
const COMPACT = new Set(['menubar'])
const CHARTS = new Set(['area-chart', 'bar-chart', 'line-chart', 'pie-chart'])
const demoTier = (key: string) => (
  WIDE.has(key) ? ' comp-demo--wide' :
  MED.has(key) ? ' comp-demo--med' :
  COMPACT.has(key) ? ' comp-demo--compact' :
  ''
)

// Preload each component's source from the built registry JSON.
function sourceFor(slug: string): string {
  try {
    const reg = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'public/r', `${slug}.json`), 'utf8'))
    return reg.files?.map((f: { content: string }) => f.content).join('\n\n') ?? ''
  } catch {
    return ''
  }
}
// Portal-based overlays (dialog, menus, tooltips…) render to document.body, so
// an auto-OPEN demo would cover the whole page. We show only the closed/trigger
// demos — click them to open. The auto-open variants still live on the isolated
// gallery (for the snapshot gate). Toaster shows a single trigger.
const PORTAL_KEYS = new Set([
  'select', 'combobox', 'dialog', 'confirm', 'tooltip', 'dropdown-menu',
  'context-menu', 'menubar', 'hover-card', 'sheet', 'alert-bell', 'bottom-nav',
])
function visibleIds(key: string, ids: string[]): string[] {
  if (key === 'toaster') return ids.filter((id) => id === 'trigger')
  if (PORTAL_KEYS.has(key)) return ids.filter((id) => !/(^|-)open|large/.test(id))
  return ids
}
/* props.json is generated by scripts/extract-props.ts and keyed by source file
 * stem (Button, table, NumberInput); the manifest is keyed by slug
 * (button, table, number-input). Lowercasing and dropping hyphens reconciles
 * the two without a hand-maintained mapping to fall out of date. */
const propsKey = (s: string) => s.toLowerCase().replace(/-/g, '')
const propsByKey = new Map(
  Object.entries(propTables as Record<string, Record<string, PropDoc[]>>).map(
    ([file, comps]) => [propsKey(file), comps],
  ),
)

const enriched = COMPONENTS.map((c) => {
  const comps = propsByKey.get(propsKey(c.install ?? c.slug)) ?? {}
  const api = Object.entries(comps)
    .map(([name, props]) => ({ name, props }))
    .sort((a, b) => a.name.localeCompare(b.name))
  return {
    ...c,
    source: sourceFor(c.install ?? c.slug),
    api,
    propCount: api.reduce((n, a) => n + a.props.length, 0),
    demoIds: c.demos.map((key) => ({ key, ids: visibleIds(key, (allDemos[key] ?? []).map((d) => d.id)) })).filter((d) => d.ids.length),
  }
})
const bySectionEnriched = SECTIONS.map((s) => ({ section: s, items: enriched.filter((c) => c.section === s) })).filter((g) => g.items.length)
const demoCount = enriched.reduce(
  (total, component) => total + component.demoIds.reduce((count, demo) => count + demo.ids.length, 0),
  0,
)
---

<Site title="Components" description={`Browse all ${COMPONENTS.length} Pouf components — layout, forms, overlays, navigation, and data — live and interactive, each with an install command and full prop docs.`} wide>
  <section class="comp-hero" aria-labelledby="components-title">
    <div class="comp-hero-copy">
      <span class="sticker comp-hero-sticker">Live component library</span>
      <h1 id="components-title" class="display comp-hero-title">Find It. Try It. Ship It.</h1>
      <p class="comp-hero-lede">Explore every Pouf component at a useful size. Change values, open overlays, inspect props, and copy the source without leaving the page.</p>
      <div class="comp-stats" aria-label="Library summary">
        <span><strong>{COMPONENTS.length}</strong> components</span>
        <span><strong>{demoCount}</strong> live demos</span>
        <span><strong>{SECTIONS.length}</strong> categories</span>
      </div>
    </div>
    <div class="comp-search-wrap">
      <label class="comp-search-label" for="component-search">Find a component</label>
      <div class="comp-search">
        <span class="comp-search-icon" aria-hidden="true">⌕</span>
        <input
          id="component-search"
          name="q"
          type="search"
          placeholder="Search components…"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="component-results"
        />
        <button id="component-search-clear" type="button" aria-label="Clear component search" hidden>Clear</button>
      </div>
      <span id="component-results" class="comp-search-results" aria-live="polite">{COMPONENTS.length} components shown</span>
    </div>
  </section>

  <div class="comp-layout">
    <aside class="comp-toc" aria-label="Component index">
      <div class="comp-toc-head">
        <strong>Browse</strong>
        <span>{COMPONENTS.length}</span>
      </div>
      <nav class="comp-toc-scroll">
        {bySection.map((g) => (
          <div class="comp-toc-group" data-toc-section={g.section}>
            <a class="comp-toc-section" href={`#section-${g.section.toLowerCase()}`}>{g.section}</a>
            {g.items.map((c) => (
              <a class="comp-toc-link" data-component-link={c.slug} href={`#${c.slug}`}>{c.title.split(',')[0].split(' (')[0]}</a>
            ))}
          </div>
        ))}
      </nav>
    </aside>

    <div class="comp-col">
      {bySectionEnriched.map((g) => (
        <div class="comp-section" data-comp-section={g.section}>
          <div class="comp-band">
            <h2 id={`section-${g.section.toLowerCase()}`} class="display comp-section-title" style={`--section-tone:${SECTION_TONE[g.section]};`}>{g.section}</h2>
            <span class="comp-band-count">{g.items.length} {g.items.length === 1 ? 'component' : 'components'}</span>
          </div>
          {g.items.map((c) => (
            <section
              id={c.slug}
              class="comp-card"
              data-component-card={c.slug}
              data-search={`${c.title} ${c.blurb} ${c.section} ${c.demos.join(' ')}`.toLowerCase()}
            >
              <div class="comp-card-head">
                <div class="comp-card-copy">
                  <span class="comp-card-kicker">{c.section}</span>
                  <h3 class="display comp-title">{c.title}</h3>
                  <p class="comp-blurb">{c.blurb}</p>
                </div>
                <div class="comp-install">
                  <span>Install</span>
                  <CopyCommand command={componentInstall(c)} compact />
                </div>
              </div>
              {/* Preview / Code / Props as real tabs rather than stacked
                  <details>. Preview stays the default panel so the
                  client:visible demos below still hydrate on scroll — inside a
                  display:none panel an IntersectionObserver never fires. */}
              <div class="comp-tabs" data-tabs>
                <div class="comp-tablist" role="tablist" aria-label={`${c.title} views`}>
                  <button
                    type="button" role="tab" class="comp-tab"
                    id={`t-${c.slug}-preview`} aria-controls={`p-${c.slug}-preview`}
                    aria-selected="true" tabindex="0"
                  >Preview</button>
                  {c.source && (
                    <button
                      type="button" role="tab" class="comp-tab"
                      id={`t-${c.slug}-code`} aria-controls={`p-${c.slug}-code`}
                      aria-selected="false" tabindex="-1"
                    >Code</button>
                  )}
                  {c.api.length > 0 && (
                    <button
                      type="button" role="tab" class="comp-tab"
                      id={`t-${c.slug}-props`} aria-controls={`p-${c.slug}-props`}
                      aria-selected="false" tabindex="-1"
                    >Props<span class="comp-api-n">{c.propCount}</span></button>
                  )}
                </div>

                <div
                  class="comp-panel" role="tabpanel"
                  id={`p-${c.slug}-preview`} aria-labelledby={`t-${c.slug}-preview`}
                >
                  <div class="comp-demos">
                    {c.demoIds.map(({ key, ids }) => ids.map((id) => (
                      <div class={`comp-demo${demoTier(key)}`}>
                        {(c.demoIds.length > 1 || ids.length > 1) && <span class="comp-cap">{id}</span>}
                        {CHARTS.has(key)
                          ? <ChartDemoBox client:visible component={key} id={id} compact />
                          : <DemoBox client:visible component={key} id={id} compact />
                        }
                      </div>
                    )))}
                  </div>
                </div>

                {c.source && (
                  <div
                    class="comp-panel" role="tabpanel" hidden
                    id={`p-${c.slug}-code`} aria-labelledby={`t-${c.slug}-code`}
                  >
                    <div class="comp-src-code"><Code code={c.source} lang="tsx" theme="material-theme-palenight" /></div>
                  </div>
                )}

                {c.api.length > 0 && (
                  <div
                    class="comp-panel" role="tabpanel" hidden
                    id={`p-${c.slug}-props`} aria-labelledby={`t-${c.slug}-props`}
                  >
                  <div class="comp-api-body">
                    {c.api.map(({ name, props }) => (
                      <div class="comp-api-block">
                        {c.api.length > 1 && <h4 class="comp-api-name">{name}</h4>}
                        <div class="comp-api-scroll">
                          <table class="comp-api-table">
                            <thead>
                              <tr><th>Prop</th><th>Type</th><th>Notes</th></tr>
                            </thead>
                            <tbody>
                              {props.map((p) => (
                                <tr>
                                  <td>
                                    <code class="comp-api-prop">{p.name}</code>
                                    {p.required && <span class="comp-api-req" title="Required">*</span>}
                                  </td>
                                  <td><code class="comp-api-type">{p.type}</code></td>
                                  <td class="comp-api-desc">{p.description}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    ))}
                  </div>
                  </div>
                )}
              </div>
            </section>
          ))}
        </div>
      ))}
      <div id="component-empty" class="comp-empty" hidden>
        <span aria-hidden="true">⌕</span>
        <h2 class="display">No components found</h2>
        <p>Try a component name such as “Button”, “Dialog”, or “Chart”.</p>
        <button id="component-empty-clear" type="button">Show all components</button>
      </div>
    </div>
  </div>

  <style>
    .comp-hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
      align-items: end;
      gap: clamp(28px, 5vw, 72px);
      margin: 8px 0 44px;
      padding: clamp(28px, 4vw, 52px);
      border-radius: 38px;
      background:
        radial-gradient(circle at 92% 12%, color-mix(in srgb, var(--pink) 38%, transparent), transparent 34%),
        radial-gradient(circle at 7% 90%, color-mix(in srgb, var(--blue) 32%, transparent), transparent 32%),
        var(--surface);
      box-shadow: var(--pouf-card);
    }
    .comp-hero-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
    .comp-hero-sticker {
      background: var(--mint);
      transform: rotate(-2deg);
      margin-bottom: 18px;
    }
    .comp-hero-title {
      max-width: 11ch;
      margin: 0;
      font-size: clamp(46px, 6.5vw, 92px);
      line-height: 0.92;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }
    .comp-hero-lede {
      max-width: 62ch;
      margin: 20px 0 0;
      color: var(--muted);
      font-size: clamp(16px, 1.5vw, 20px);
      font-weight: 800;
      line-height: 1.55;
      text-wrap: pretty;
    }
    .comp-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 24px;
    }
    .comp-stats span {
      display: inline-flex;
      align-items: baseline;
      gap: 5px;
      min-height: 32px;
      padding: 7px 12px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg) 78%, transparent);
      color: var(--muted);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.02em;
      box-shadow: var(--pouf-field);
    }
    .comp-stats strong { color: var(--ink); font-size: 14px; font-variant-numeric: tabular-nums; }
    .comp-search-wrap {
      min-width: 0;
      padding: 24px;
      border-radius: 28px;
      background: color-mix(in srgb, var(--surface) 82%, transparent);
      box-shadow: var(--pouf-row);
    }
    .comp-search-label {
      display: block;
      margin: 0 0 9px 4px;
      color: var(--ink);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .comp-search {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 56px;
      padding: 0 12px 0 16px;
      border-radius: 19px;
      background: var(--bg);
      box-shadow: var(--pouf-field);
    }
    .comp-search:focus-within { box-shadow: var(--pouf-field-focus); }
    .comp-search-icon {
      flex: none;
      color: var(--muted);
      font-family: var(--font);
      font-size: 26px;
      line-height: 1;
      transform: rotate(-18deg);
    }
    .comp-search input {
      flex: 1;
      align-self: stretch;
      min-width: 0;
      min-height: 44px;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--ink);
      font: 800 16px/1.2 var(--font);
    }
    .comp-search input::placeholder { color: var(--muted); opacity: 0.78; }
    .comp-search button {
      flex: none;
      min-height: 34px;
      border: 0;
      border-radius: 12px;
      padding: 7px 10px;
      background: var(--purple);
      color: var(--on-accent);
      font: 900 12px/1 var(--font);
      cursor: pointer;
      touch-action: manipulation;
      box-shadow: var(--pouf-control-active);
    }
    .comp-search button:hover { filter: saturate(1.08) brightness(0.98); }
    .comp-search button:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
    .comp-search-results {
      display: block;
      margin: 10px 4px 0;
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }

    .comp-layout {
      display: grid;
      grid-template-columns: 230px minmax(0, 1fr);
      gap: clamp(28px, 3vw, 48px);
      align-items: start;
    }
    .comp-toc {
      position: sticky;
      top: 92px;
      display: flex;
      flex-direction: column;
      max-height: calc(100vh - 112px);
      background: color-mix(in srgb, var(--surface) 70%, transparent);
      border-radius: 24px;
      box-shadow: var(--pouf-card);
      overflow: hidden;
      overscroll-behavior: contain;
    }
    .comp-toc-head {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      padding: 12px 16px;
      background: color-mix(in srgb, var(--purple) 22%, var(--surface));
      color: var(--ink);
      font-size: 14px;
      font-weight: 900;
    }
    .comp-toc-head span {
      display: grid;
      place-items: center;
      min-width: 28px;
      min-height: 24px;
      padding: 0 7px;
      border-radius: 999px;
      background: var(--surface);
      color: var(--muted);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }
    .comp-toc-scroll {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      padding: 8px 8px calc(var(--lip) + 18px);
      mask-image: linear-gradient(to bottom, transparent 0, #000 12px, #000 calc(100% - 28px), transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12px, #000 calc(100% - 28px), transparent 100%);
    }
    .comp-toc-group { display: flex; flex-direction: column; gap: 2px; }
    .comp-toc-section {
      color: var(--muted);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
      text-decoration: none;
      text-transform: uppercase;
      padding: 12px 12px 4px;
    }
    .comp-toc-link {
      display: block;
      font-weight: 800;
      font-size: 14px;
      color: var(--ink);
      text-decoration: none;
      padding: 6px 12px;
      border-radius: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: background 140ms ease, color 140ms ease, transform 140ms ease;
    }
    .comp-toc-link:hover { background: rgba(201, 168, 255, 0.22); transform: translateX(2px); }
    .comp-toc-link[aria-current='location'] {
      background: var(--purple);
      color: var(--on-accent);
      box-shadow: var(--pouf-control-active);
    }
    .comp-toc-link:focus-visible,
    .comp-toc-section:focus-visible { outline: 3px solid var(--ink); outline-offset: -1px; }

    .comp-col { min-width: 0; display: flex; flex-direction: column; gap: 56px; }
    .comp-section { display: flex; flex-direction: column; gap: 24px; }
    .comp-band { display: flex; align-items: center; gap: 14px; scroll-margin-top: 100px; }
    .comp-section-title {
      position: relative;
      margin: 0;
      padding-left: 18px;
      font-size: clamp(26px, 3vw, 38px);
      line-height: 1;
      scroll-margin-top: 100px;
    }
    .comp-section-title::before {
      content: '';
      position: absolute;
      left: 0;
      top: 10%;
      bottom: 3%;
      width: 8px;
      border-radius: 999px;
      background: var(--section-tone);
      box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.08);
    }
    .comp-band-count { font-weight: 900; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

    /* Each component on its own cushion card — roomy, but boxed so it reads as a
       unit (the toybox presentation, kept full-width for readability). */
    .comp-card {
      scroll-margin-top: 92px;
      content-visibility: auto;
      contain-intrinsic-size: auto 720px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: clamp(20px, 2.4vw, 32px);
      border-radius: 30px;
      background: color-mix(in srgb, var(--surface) 95%, var(--purple));
      box-shadow: var(--pouf-card);
    }
    .comp-card:target {
      box-shadow: var(--pouf-card), 0 0 0 4px color-mix(in srgb, var(--purple) 72%, transparent);
    }
    .comp-card-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
      align-items: end;
      gap: 22px;
    }
    .comp-card-copy { min-width: 0; }
    .comp-card-kicker {
      display: block;
      margin-bottom: 5px;
      color: var(--muted);
      font-size: 10.5px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .comp-title { font-size: clamp(27px, 3vw, 38px); line-height: 1.02; margin: 0; text-wrap: balance; }
    .comp-blurb { max-width: 62ch; font-size: 15px; line-height: 1.45; font-weight: 800; color: var(--muted); margin: 7px 0 0; text-wrap: pretty; }
    .comp-install { min-width: 0; }
    .comp-install > span {
      display: block;
      margin: 0 0 7px 3px;
      color: var(--muted);
      font-size: 10.5px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* Variations in a responsive grid, so they sit side-by-side instead of a
       tall stack. Three width tiers: small = 3-per-row, med = 2-per-row, wide =
       the full row (charts, tables, app shells).

       A SIX-column base with explicit spans, deliberately not `auto-fit`:
       auto-fit collapses tracks that are empty across the WHOLE grid, so a card
       whose demos are all `span 2` in a 3-track grid silently became a 2-track
       grid — i.e. every demo full-width, which is what we were trying to avoid.
       Fixed tracks make the tier mean the same thing in every card. */
    /* Tabs. Roving tabindex + arrow keys, per the ARIA tabs pattern. */
    .comp-tablist {
      display: flex;
      gap: 6px;
      margin: 4px 0 16px;
      padding-bottom: 10px;
      border-bottom: 2px solid color-mix(in srgb, var(--purple) 22%, transparent);
      flex-wrap: wrap;
    }
    .comp-tab {
      font: inherit;
      font-size: 14px;
      font-weight: 900;
      color: var(--muted);
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 7px 14px;
      border-radius: var(--r-pill, 999px);
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: background 140ms ease, color 140ms ease;
    }
    .comp-tab:hover { color: var(--ink); background: rgba(201, 168, 255, 0.16); }
    /* Selected reads as a pressed cushion, matching Segmented — depth is the
       selection signal in this system, not colour alone. */
    .comp-tab[aria-selected='true'] {
      color: var(--on-accent);
      background: var(--purple);
      box-shadow: var(--pouf-control-active);
      transform: translateY(1px);
    }
    .comp-tab:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
    .comp-panel { animation: comp-panel-in 160ms ease; min-width: 0; }
    @keyframes comp-panel-in { from { opacity: 0; } to { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .comp-tab { transition: none; }
      .comp-panel { animation: none; }
    }

    .comp-api-n {
      display: inline-block;
      margin-left: 8px;
      padding: 1px 8px;
      border-radius: 999px;
      background: rgba(201, 168, 255, 0.35);
      font-size: 12px;
      font-weight: 900;
    }
    .comp-api-body { display: flex; flex-direction: column; gap: 18px; margin-top: 10px; }
    .comp-api-name { font-size: 15px; font-weight: 900; margin: 0 0 6px; }
    /* The type column is the one that overflows on a phone; let the table
       scroll inside its own box rather than widening the page. */
    .comp-api-scroll { overflow-x: auto; }
    .comp-api-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .comp-api-table th {
      text-align: left;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--muted);
      padding: 6px 12px 6px 0;
      border-bottom: 2px solid rgba(201, 168, 255, 0.3);
      white-space: nowrap;
    }
    .comp-api-table td {
      padding: 9px 12px 9px 0;
      vertical-align: top;
      border-bottom: 1px solid rgba(201, 168, 255, 0.16);
    }
    .comp-api-prop { font-weight: 900; color: var(--ink); white-space: nowrap; }
    .comp-api-req { color: var(--pink); font-weight: 900; margin-left: 2px; }
    .comp-api-type {
      font-family: ui-monospace, Menlo, monospace;
      font-size: 13px;
      color: var(--muted);
      white-space: nowrap;
    }
    .comp-api-desc { color: var(--muted); font-weight: 700; min-width: 220px; }

    .comp-demos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: start; }
    .comp-demo { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .comp-demo--wide { grid-column: 1 / -1; }
    .comp-demo--compact { width: min(100%, 480px); justify-self: start; }
    /* BottomNav is intentionally viewport-gated in the component itself. Its
       mobile docs viewport is a contained preview on a desktop page, so opt
       that simulated viewport in explicitly. */
    :global([data-demo-viewport='mobile'] .pouf-bottomnav) { display: grid; }
    /* A lone variation has nothing to sit beside — let it use the whole row
       rather than stranding four empty columns. */
    .comp-demo:only-child { grid-column: 1 / -1; }
    @media (max-width: 1180px) { .comp-demos { grid-template-columns: minmax(0, 1fr); } }
    .comp-cap { font-size: 10.5px; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); opacity: 0.7; }
    .comp-empty {
      display: grid;
      place-items: center;
      gap: 10px;
      min-height: 320px;
      padding: 40px;
      border-radius: 30px;
      background: var(--surface);
      text-align: center;
      box-shadow: var(--pouf-card);
    }
    .comp-empty[hidden] { display: none; }
    .comp-empty > span { color: var(--muted); font-size: 48px; line-height: 1; transform: rotate(-18deg); }
    .comp-empty h2 { margin: 0; font-size: 30px; }
    .comp-empty p { margin: 0; color: var(--muted); font-weight: 800; }
    .comp-empty button {
      min-height: 44px;
      margin-top: 8px;
      border: 0;
      border-radius: 15px;
      padding: 10px 16px;
      background: var(--purple);
      color: var(--on-accent);
      font: 900 14px/1 var(--font);
      cursor: pointer;
      box-shadow: var(--pouf-control);
    }
    .comp-empty button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

    .comp-src > summary { cursor: pointer; font-weight: 900; font-size: 14px; color: var(--ink); list-style: none; padding: 2px 0; }
    .comp-src > summary::-webkit-details-marker { display: none; }
    .comp-src > summary::before { content: '‹/›  '; color: var(--muted); font-family: ui-monospace, monospace; }
    .comp-src[open] > summary::before { content: '▾  '; }
    .comp-src-code { margin-top: 8px; max-height: 420px; overflow: auto; border-radius: 16px; }

    @media (max-width: 900px) {
      .comp-hero { grid-template-columns: minmax(0, 1fr); }
      .comp-hero-title { max-width: 13ch; }
      .comp-layout { grid-template-columns: minmax(0, 1fr); }
      .comp-toc { display: none; }
    }
    @media (max-width: 680px) {
      .comp-hero { margin-top: 0; padding: 24px 20px 30px; border-radius: 28px; }
      .comp-hero-title { font-size: clamp(42px, 13vw, 64px); }
      .comp-search-wrap { padding: 16px; }
      .comp-card-head { grid-template-columns: minmax(0, 1fr); }
      .comp-card { padding: 20px 16px 24px; border-radius: 24px; }
      .comp-section-title { font-size: 30px; }
      .comp-band { align-items: baseline; justify-content: space-between; }
      .comp-tab { padding-inline: 11px; }
      .comp-api-desc { min-width: 180px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .comp-toc-link,
      .comp-search button { transition: none; }
    }
  </style>

  <script is:inline>
    /* ARIA tabs: click to select, Left/Right (and Home/End) to move, with a
       roving tabindex so the tablist is a single tab stop. Plain inline JS —
       38 cards' worth of React islands would be a lot of hydration for three
       buttons. */
    document.querySelectorAll('[data-tabs]').forEach(function (group) {
      var tabs = Array.prototype.slice.call(group.querySelectorAll('[role="tab"]'))
      if (tabs.length < 2) return

      function select(tab, focus) {
        tabs.forEach(function (t) {
          var on = t === tab
          t.setAttribute('aria-selected', String(on))
          t.tabIndex = on ? 0 : -1
          var panel = document.getElementById(t.getAttribute('aria-controls'))
          if (panel) panel.hidden = !on
        })
        if (focus) tab.focus()
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () { select(tab, false) })
        tab.addEventListener('keydown', function (e) {
          var next =
            e.key === 'ArrowRight' ? (i + 1) % tabs.length
            : e.key === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length
            : e.key === 'Home' ? 0
            : e.key === 'End' ? tabs.length - 1
            : -1
          if (next < 0) return
          e.preventDefault()
          select(tabs[next], true)
        })
      })
    })

    /* Search is page navigation state, so keep it in the URL. This makes a
       filtered component library linkable and restores the same view on
       reload/back without hydrating the whole page as an application. */
    var search = document.getElementById('component-search')
    var clear = document.getElementById('component-search-clear')
    var emptyClear = document.getElementById('component-empty-clear')
    var results = document.getElementById('component-results')
    var empty = document.getElementById('component-empty')
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-component-card]'))
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-component-link]'))
    var sections = Array.prototype.slice.call(document.querySelectorAll('[data-comp-section]'))
    var tocGroups = Array.prototype.slice.call(document.querySelectorAll('[data-toc-section]'))

    function setQuery(value, writeURL) {
      if (!search) return
      var query = String(value || '').trim().toLowerCase()
      search.value = value || ''
      var shown = 0

      cards.forEach(function (card) {
        var match = !query || (card.getAttribute('data-search') || '').indexOf(query) >= 0
        card.hidden = !match
        if (match) shown += 1
      })
      links.forEach(function (link) {
        var slug = link.getAttribute('data-component-link')
        var card = document.querySelector('[data-component-card="' + slug + '"]')
        link.hidden = !card || card.hidden
      })
      sections.forEach(function (section) {
        section.hidden = !section.querySelector('[data-component-card]:not([hidden])')
      })
      tocGroups.forEach(function (group) {
        group.hidden = !group.querySelector('[data-component-link]:not([hidden])')
      })

      if (clear) clear.hidden = !query
      if (empty) empty.hidden = shown !== 0
      if (results) results.textContent = shown + (shown === 1 ? ' component shown' : ' components shown')

      if (writeURL) {
        var url = new URL(window.location.href)
        if (query) url.searchParams.set('q', value.trim())
        else url.searchParams.delete('q')
        history.replaceState(null, '', url)
      }
    }

    if (search) {
      var initialQuery = new URL(window.location.href).searchParams.get('q') || ''
      setQuery(initialQuery, false)
      search.addEventListener('input', function () { setQuery(search.value, true) })
    }
    if (clear) clear.addEventListener('click', function () {
      setQuery('', true)
      search && search.focus()
    })
    if (emptyClear) emptyClear.addEventListener('click', function () {
      setQuery('', true)
      search && search.focus()
    })

    /* Highlight the component whose card currently leads the viewport. */
    if ('IntersectionObserver' in window) {
      var activeObserver = new IntersectionObserver(function (entries) {
        var visible = entries
          .filter(function (entry) { return entry.isIntersecting && !entry.target.hidden })
          .sort(function (a, b) { return b.intersectionRatio - a.intersectionRatio })
        if (!visible.length) return
        var slug = visible[0].target.getAttribute('data-component-card')
        links.forEach(function (link) {
          if (link.getAttribute('data-component-link') === slug) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
      }, { rootMargin: '-96px 0px -58% 0px', threshold: [0.08, 0.3, 0.6] })
      cards.forEach(function (card) { activeObserver.observe(card) })
    }
  </script>
