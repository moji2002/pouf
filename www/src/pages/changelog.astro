---
import Site from '../layouts/Site.astro'
let changelog: { month: string; subjects: string[] }[] = []
try {
  changelog = (await import('../data/changelog.json')).default as typeof changelog
} catch {}
const monthFormatter = new Intl.DateTimeFormat('en', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
const label = (m: string) => {
  const [y, mo] = m.split('-')
  return monthFormatter.format(new Date(Date.UTC(Number(y), Number(mo) - 1, 1)))
}
const changeCount = changelog.reduce((sum, group) => sum + group.subjects.length, 0)
const latestMonth = changelog[0]?.month
const typeOf = (subject: string) =>
  subject.startsWith('feat') ? 'Feature' : subject.startsWith('fix') ? 'Fix' : 'Update'
const toneOf = (subject: string) =>
  subject.startsWith('feat') ? 'mint' : subject.startsWith('fix') ? 'pink' : 'blue'
---

<Site title="Changelog" description="What changed in Pouf, from the registry's git history." wide>
  <article class="changelog">
    <header class="changelog-hero">
      <div class="changelog-hero__copy">
        <span class="sticker" style="background:var(--yellow); transform:rotate(-2deg);">Fresh from git</span>
        <h1 class="display">Changelog</h1>
        <p>Straight from the commits that shipped the components. No spin.</p>
      </div>
      <div class="changelog-hero__summary" aria-label="Changelog summary">
        <div>
          <strong>{changeCount}</strong>
          <span>shipped changes</span>
        </div>
        <div>
          <strong>{changelog.length}</strong>
          <span>release {changelog.length === 1 ? 'month' : 'months'}</span>
        </div>
        {latestMonth && (
          <div>
            <strong class="changelog-hero__latest">{label(latestMonth)}</strong>
            <span>latest release</span>
          </div>
        )}
      </div>
      <span class="changelog-hero__orb changelog-hero__orb--one" aria-hidden="true"></span>
      <span class="changelog-hero__orb changelog-hero__orb--two" aria-hidden="true"></span>
    </header>

    {changelog.length === 0 && (
      <section class="changelog-empty">
        <span aria-hidden="true">✦</span>
        <p>Nothing shipped yet. Give it a sec.</p>
      </section>
    )}

    {changelog.map((g) => (
      <section class="release" id={`release-${g.month}`}>
        <div class="release__date">
          <span aria-hidden="true"></span>
          <time datetime={`${g.month}-01`}>{label(g.month)}</time>
          <small>{g.subjects.length} {g.subjects.length === 1 ? 'change' : 'changes'}</small>
        </div>
        <ul class="release__notes">
          {g.subjects.map((s) => (
            <li>
              <span class="release__type" style={`background:var(--${toneOf(s)});`}>{typeOf(s)}</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Site>

<style>
  .changelog {
    display: flex;
    flex-direction: column;
    gap: clamp(34px, 6vw, 72px);
    min-width: 0;
  }
  .changelog-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(310px, 0.75fr);
    gap: clamp(28px, 5vw, 68px);
    align-items: end;
    margin-top: 8px;
    padding: clamp(30px, 6vw, 68px);
    overflow: hidden;
    border-radius: 38px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 94%, transparent), color-mix(in srgb, var(--purple) 24%, var(--surface)));
    box-shadow: var(--pouf-card);
  }
  .changelog-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .changelog-hero h1 {
    margin: 0;
    font-size: clamp(50px, 9vw, 104px);
    text-wrap: balance;
  }
  .changelog-hero__copy > p {
    max-width: 650px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
    font-weight: 750;
    text-wrap: pretty;
  }
  .changelog-hero__summary {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .changelog-hero__summary > div {
    display: flex;
    min-width: 0;
    min-height: 112px;
    flex-direction: column;
    justify-content: flex-end;
    gap: 5px;
    padding: 18px 20px calc(18px + var(--lip));
    border-radius: 24px;
    color: var(--on-accent);
    background: var(--surface);
    box-shadow: var(--pouf-control);
  }
  .changelog-hero__summary > div:nth-child(1) {
    background: var(--mint);
  }
  .changelog-hero__summary > div:nth-child(2) {
    background: var(--pink);
  }
  .changelog-hero__summary > div:nth-child(3) {
    grid-column: 1 / -1;
    min-height: 88px;
    background: var(--blue);
  }
  .changelog-hero__summary strong {
    font-family: var(--display);
    font-size: 36px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .changelog-hero__summary .changelog-hero__latest {
    font-size: clamp(22px, 3vw, 30px);
  }
  .changelog-hero__summary span {
    font-size: 13px;
    font-weight: 900;
  }
  .changelog-hero__orb {
    position: absolute;
    z-index: -1;
    display: block;
    border-radius: 999px;
    box-shadow: var(--pouf-blob);
  }
  .changelog-hero__orb--one {
    width: 180px;
    height: 180px;
    top: -98px;
    left: 48%;
    background: var(--orange);
  }
  .changelog-hero__orb--two {
    width: 120px;
    height: 120px;
    right: -46px;
    bottom: 14%;
    background: var(--yellow);
  }
  .release {
    display: grid;
    grid-template-columns: minmax(190px, 0.32fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 58px);
    align-items: start;
    scroll-margin-top: 104px;
  }
  .release__date {
    position: sticky;
    top: 96px;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 4px 12px;
    align-items: center;
    padding: 18px 18px calc(18px + var(--lip));
    border-radius: 22px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: var(--pouf-control);
  }
  .release__date > span {
    grid-row: 1 / 3;
    width: 16px;
    height: 16px;
    border: 4px solid var(--surface);
    border-radius: 999px;
    background: var(--purple);
    box-shadow: 0 0 0 2px var(--purple);
  }
  .release__date time {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 800;
    line-height: 1.05;
    text-wrap: balance;
  }
  .release__date small {
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }
  .release__notes {
    display: grid;
    gap: 12px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .release__notes li {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    min-width: 0;
    padding: 16px 18px calc(16px + var(--lip));
    border-radius: 20px;
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: var(--pouf-control);
    line-height: 1.5;
    font-weight: 750;
    overflow-wrap: anywhere;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .release__notes li:hover {
    transform: translateY(-2px);
    box-shadow: var(--pouf-control-hover);
  }
  .release__type {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 10px;
    color: var(--on-accent);
    font-size: 11px;
    font-weight: 950;
  }
  .changelog-empty {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 28px;
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--pouf-card);
  }
  .changelog-empty span {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 16px;
    color: var(--on-accent);
    background: var(--yellow);
    box-shadow: var(--pouf-blob);
  }
  .changelog-empty p {
    margin: 0;
    color: var(--muted);
    font-weight: 800;
  }
  @media (max-width: 820px) {
    .changelog-hero,
    .release {
      grid-template-columns: minmax(0, 1fr);
    }
    .release__date {
      position: static;
      width: fit-content;
    }
  }
  @media (max-width: 560px) {
    .changelog {
      gap: 34px;
    }
    .changelog-hero {
      padding: 30px 20px 34px;
      border-radius: 28px;
    }
    .changelog-hero__summary {
      grid-template-columns: minmax(0, 1fr);
    }
    .changelog-hero__summary > div:nth-child(3) {
      grid-column: auto;
    }
    .changelog-hero__summary > div {
      min-height: 88px;
    }
    .release__notes li {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding: 16px 16px calc(16px + var(--lip));
    }
    .release__type {
      width: fit-content;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .release__notes li {
      transition: none;
    }
    .release__notes li:hover {
      transform: none;
    }
  }
</style>
