---
import Site from '../layouts/Site.astro'
import { HeroShowcase } from '../components/HeroShowcase'
import { ComponentWall } from '../components/ComponentWall'
import { IconBlob } from '../components/IconBlob'
import { CopyCommand } from '../components/CopyCommand'
import { COMPONENTS } from '../data/manifest'
import { BLOCKS, TEMPLATES } from '../data/blocks'
import { installCommand, SITE_ORIGIN } from '../data/site'

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Pouf',
  description: 'A puffy, pastel, maximalist UI kit for React. Claymorphism as a shadcn-style registry — copy it in, own the source.',
  url: SITE_ORIGIN,
  codeRepository: 'https://github.com/moji2002/pouf',
  programmingLanguage: ['TypeScript', 'CSS'],
  runtimePlatform: 'React',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'Mojtaba Beheshti', url: 'https://github.com/moji2002' },
}

const TONES = [
  { name: 'purple', var: '--purple' },
  { name: 'pink', var: '--pink' },
  { name: 'blue', var: '--blue' },
  { name: 'mint', var: '--mint' },
  { name: 'yellow', var: '--yellow' },
  { name: 'orange', var: '--orange' },
]
const STATS = [
  { n: String(COMPONENTS.length), label: 'components', tone: '--purple' },
  { n: String(BLOCKS.length), label: 'blocks', tone: '--mint' },
  { n: String(TEMPLATES.length), label: 'templates', tone: '--pink' },
  /* Not "0 runtime deps" — that was never true: the registry ships Radix,
     recharts, framer-motion and Tabler icons. What IS true is the shadcn
     model: nothing installs `pouf` itself, the source lands in your repo. */
  { n: '0', label: 'lock-in', tone: '--yellow' },
  { n: 'MIT', label: 'licensed', tone: '--blue' },
]
const FEATURED_TEMPLATES = TEMPLATES
const FEATURED_BLOCKS = BLOCKS.slice(0, 6)
---

<Site wide schema={softwareSchema}>
  <!-- HERO -->
  <section style="display:grid; grid-template-columns: 1.05fr 0.95fr; gap:48px; align-items:center; padding:24px 0 40px;" class="hero-grid">
    <div style="display:flex; flex-direction:column; gap:26px;">
      <span class="sticker pop" style="background:var(--yellow); align-self:flex-start; transform:rotate(-2deg); animation-delay:60ms;">Claymorphism for React</span>
      <h1 class="display pop hero-title" style="font-size:clamp(52px, 7vw, 92px); animation-delay:120ms;">
        <span class="hero-line">Soft software.</span>
        <span class="hero-line hero-line--built">
          <span class="hero-highlight">Absurdly</span> built.
        </span>
      </h1>
      <p class="pop" style="font-size:21px; font-weight:800; color:var(--muted); max-width:36ch; margin:0; animation-delay:200ms;">
        Pouf is a puffy, pastel, <strong style="color:var(--ink);">maximalist</strong> UI kit — and the best-looking one you'll install this year. Every surface a cushion — bright, chunky, tactile. Copy it in shadcn-style and own the source.
      </p>
      {/* No max-width: the 560px cap was sized around the old pouf.dev command.
          pouf.worksonmy.dev is 10 characters longer — measured 525px of content
          in a 480px box, truncating the homepage's primary call to action
          mid-URL. It scrolls, but a command you must scroll to read is a
          command you cannot copy by eye. */}
      <div class="pop" style="animation-delay:280ms;">
        <CopyCommand client:load command={installCommand('button')} />
      </div>
      <div class="pop" style="display:flex; gap:14px; flex-wrap:wrap; animation-delay:360ms;">
        <a href="/docs/" style="text-decoration:none; color:var(--on-accent); font-weight:900; font-size:17px; background:var(--purple); padding:16px 30px; border-radius:20px; box-shadow: var(--pouf-control);">Get started</a>
        <a href="/examples" style="text-decoration:none; color:var(--ink); font-weight:900; font-size:17px; background:var(--surface); padding:16px 30px; border-radius:20px; box-shadow: var(--pouf-control);">See {TEMPLATES.length} templates</a>
      </div>
    </div>

    <!-- Layered live collage -->
    <div class="pop" style="position:relative; animation-delay:300ms;">
      <span class="sticker" style="background:var(--mint); position:absolute; top:-18px; left:-10px; z-index:3; transform:rotate(-6deg);">Live components ↓</span>
      <span class="sticker" style="background:var(--pink); position:absolute; bottom:-14px; right:8px; z-index:3; transform:rotate(5deg);">no className, no drift, no excuses</span>
      <div class="collage" style="transform:rotate(1.2deg);">
        <HeroShowcase client:visible />
      </div>
    </div>
  </section>

  <!-- STAT STRIP -->
  <section class="reveal stat-strip" style="display:grid; grid-template-columns:repeat(5, minmax(0,1fr)); gap:16px; padding:12px 0 56px;">
    {STATS.map((s) => (
      <div class="cushion-tone" style={`background:var(${s.tone}); padding:26px 24px; display:flex; flex-direction:column; gap:2px;`}>
        <span class="display" style="font-size:44px;">{s.n}</span>
        <span style="font-weight:900; text-transform:uppercase; letter-spacing:1.5px; font-size:12px; color:var(--on-accent); opacity:0.65;">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- COMPONENT WALL -->
  <section class="reveal" style="padding:24px 0 56px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:24px; flex-wrap:wrap;">
      <div>
        <span class="sticker" style="background:var(--blue); transform:rotate(-2deg);">Everything's live</span>
        <h2 class="display" style="font-size:clamp(34px,4.5vw,52px); margin:14px 0 0;">A whole toybox.</h2>
      </div>
      <a href="/components" style="text-decoration:none; color:var(--ink); font-weight:900; background:var(--surface); padding:12px 22px; border-radius:16px; box-shadow: var(--pouf-control);">Browse all →</a>
    </div>
    <ComponentWall client:visible />
  </section>

  <!-- TEMPLATES SHOWCASE -->
  <section class="reveal" style="padding:24px 0 56px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:24px; flex-wrap:wrap;">
      <div>
        <span class="sticker" style="background:var(--pink); transform:rotate(-2deg);">Copy a whole screen</span>
        <h2 class="display" style="font-size:clamp(34px,4.5vw,52px); margin:14px 0 0;">Templates, not snippets.</h2>
      </div>
      <a href="/examples" style="text-decoration:none; color:var(--ink); font-weight:900; background:var(--surface); padding:12px 22px; border-radius:16px; box-shadow: var(--pouf-control);">All {TEMPLATES.length} →</a>
    </div>
    <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:20px;" class="tpl-grid">
      {FEATURED_TEMPLATES.map((b, i) => (
        <a href={`/examples/${b.slug}`} style="text-decoration:none; color:var(--on-accent);">
          <div class="ex-card" style={`background:var(--${b.tone}); border-radius:26px; padding:24px; box-shadow: var(--pouf-control); display:flex; flex-direction:column; gap:12px; height:100%; transform:rotate(${i % 2 === 0 ? '-0.5' : '0.5'}deg);`}>
            <IconBlob client:visible icon={b.icon as any} tone="purple" size="sm" />
            <h3 class="display" style="font-size:24px; margin:4px 0 0;">{b.title}</h3>
            <p style="margin:0; color:var(--on-accent); opacity:0.72; font-weight:800; font-size:14px;">{b.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- BLOCKS SHOWCASE -->
  <section class="reveal" style="padding:24px 0 56px;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:24px; flex-wrap:wrap;">
      <div>
        <span class="sticker" style="background:var(--mint); transform:rotate(-2deg);">Or just one section</span>
        <h2 class="display" style="font-size:clamp(34px,4.5vw,52px); margin:14px 0 0;">Blocks that already work.</h2>
        <p style="font-weight:800; color:var(--muted); margin:10px 0 0; max-width:52ch;">Wired, not wireframed: validation, filters, empty states, optimistic updates. Paste one into a page you already have.</p>
      </div>
      <a href="/blocks" style="text-decoration:none; color:var(--ink); font-weight:900; background:var(--surface); padding:12px 22px; border-radius:16px; box-shadow: var(--pouf-control);">All {BLOCKS.length} →</a>
    </div>
    <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:20px;" class="tpl-grid">
      {FEATURED_BLOCKS.map((b, i) => (
        <a href={`/blocks/${b.slug}`} style="text-decoration:none; color:var(--on-accent);">
          <div class="ex-card" style={`background:var(--${b.tone}); border-radius:26px; padding:24px; box-shadow: var(--pouf-control); display:flex; flex-direction:column; gap:12px; height:100%; transform:rotate(${i % 2 === 0 ? '0.5' : '-0.5'}deg);`}>
            <IconBlob client:visible icon={b.icon as any} tone="purple" size="sm" />
            <h3 class="display" style="font-size:24px; margin:4px 0 0;">{b.title}</h3>
            <p style="margin:0; color:var(--on-accent); opacity:0.72; font-weight:800; font-size:14px;">{b.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- TONE SHOWCASE -->
  <section class="reveal" style="padding:24px 0 56px;">
    <h2 class="display" style="font-size:clamp(30px,4vw,44px); margin:0 0 8px;">Six pastels, one system.</h2>
    <p style="font-weight:800; color:var(--muted); margin:0 0 24px;">Components speak intent — <code>tone="up"</code>, not <code>tone="mint"</code> — so a re-theme is one place.</p>
    <div style="display:grid; grid-template-columns:repeat(6, minmax(0,1fr)); gap:14px;" class="tone-strip">
      {TONES.map((t) => (
        <div style={`aspect-ratio:1; background:var(${t.var}); border-radius:24px; box-shadow: var(--pouf-control); display:flex; align-items:flex-end; padding:16px;`}>
          <span style="font-weight:900; color:var(--on-accent); text-transform:capitalize;">{t.name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURES -->
  <section class="reveal feature-grid" style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:20px; padding:24px 0 64px;">
    <div class="cushion-tone" style="background:var(--purple); padding:30px;">
      <h3 class="display" style="font-size:26px; margin:0 0 10px;">Depth is the affordance</h3>
      <p style="margin:0; font-weight:800; color:var(--on-accent); opacity:0.75;">Buttons press in. Badges stay flat. State you can feel before you read it.</p>
    </div>
    <div class="cushion-tone" style="background:var(--mint); padding:30px;">
      <h3 class="display" style="font-size:26px; margin:0 0 10px;">You own the source</h3>
      <p style="margin:0; font-weight:800; color:var(--on-accent); opacity:0.75;">Install with the shadcn CLI or copy the file. Tailwind v4 + Radix under the hood. No dependency to lock.</p>
    </div>
    <div class="cushion-tone" style="background:var(--pink); padding:30px;">
      <h3 class="display" style="font-size:26px; margin:0 0 10px;">Any icon, any lib</h3>
      <p style="margin:0; font-weight:800; color:var(--on-accent); opacity:0.75;">Named roles for convenience, or drop in lucide, phosphor, your own SVG. The vocabulary is a default, not a cage.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="reveal" style="padding:0 0 32px;">
    <div class="cushion" style="padding:48px; text-align:center; display:flex; flex-direction:column; align-items:center; gap:18px;">
      <h2 class="display" style="font-size:clamp(32px,5vw,56px); margin:0;">Go make something puffy.</h2>
      <p style="font-weight:800; color:var(--muted); margin:0; font-size:18px;">One command. Component and its dependencies, straight into your project. That's the whole trick.</p>
      <div style="max-width:520px; width:100%;"><CopyCommand client:load command={installCommand('dashboard')} /></div>
    </div>
  </section>

  <style>
    .hero-line {
      display: block;
    }
    .hero-line--built {
      white-space: nowrap;
    }
    .hero-highlight {
      display: inline-block;
      padding: 0 18px;
      border-radius: 20px;
      background: var(--purple);
      color: var(--on-accent);
      box-shadow: inset 0 -8px 0 rgba(0,0,0,0.08);
      transform: rotate(-1.5deg);
    }
    .ex-card { transition: transform 160ms ease; }
    .ex-card:hover { transform: rotate(0deg) translateY(-4px) !important; }
    /* Two-up before one-up: at ~1000px three cards squeeze their blurbs into
       four-line towers, but two still read comfortably. */
    @media (max-width: 1080px) and (min-width: 901px) {
      .tpl-grid { grid-template-columns: repeat(2, minmax(0,1fr)) !important; }
    }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: minmax(0,1fr) !important; }
      .stat-strip { grid-template-columns: repeat(2, minmax(0,1fr)) !important; }
      .feature-grid { grid-template-columns: minmax(0,1fr) !important; }
      .tone-strip { grid-template-columns: repeat(3, minmax(0,1fr)) !important; }
      .tpl-grid { grid-template-columns: minmax(0,1fr) !important; }
      /* :global — .wall is rendered by the ComponentWall React island, so it
         carries no data-astro-cid attribute and a scoped selector never
         matched it. Every .wall breakpoint here was dead until now. */
      :global(.wall) { grid-template-columns: repeat(2, minmax(0,1fr)) !important; }
    }
    @media (max-width: 560px) {
      .hero-title {
        font-size: clamp(32px, 10.5vw, 48px) !important;
      }
      .hero-highlight {
        padding-inline: 12px;
        border-radius: 16px;
      }
      :global(.wall) { grid-template-columns: minmax(0,1fr) !important; }
      /* Tiles carry `grid-column: span 2`. Collapsing the track list alone is
         not enough: a span-2 item in a one-column grid makes Grid generate an
         IMPLICIT second column, so the row ends up twice the container width
         and the page scrolls sideways. The items have to be un-spanned too. */
      :global(.wall) > :global(*) { grid-column: 1 / -1 !important; }
    }
  </style>
</Site>
